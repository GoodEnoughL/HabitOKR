{
  "expo": {
    "name": "HabitOKR",
    "slug": "HabitOKR",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "habitokr",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitokr.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-haptics"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e2e11062-4a60-47ea-be18-fda355f013fe"
      }
    },
    "owner": "goodenoughl"
  }
}
